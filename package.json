{
  "name": "admission-enquiry-crm",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "uvicorn": "./bin/uvicorn.cjs"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "start": "node ./bin/uvicorn.cjs --host 0.0.0.0 --port $PORT",
    "postinstall": "mkdir -p node_modules/.bin && cp bin/uvicorn.cjs node_modules/.bin/uvicorn 2>/dev/null && chmod +x node_modules/.bin/uvicorn bin/uvicorn bin/uvicorn.cjs uvicorn 2>/dev/null || true"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
