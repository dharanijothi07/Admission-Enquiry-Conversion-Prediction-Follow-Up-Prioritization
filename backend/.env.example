# Copy this file to ".env" and edit the values. Never commit ".env" to GitHub.

# PostgreSQL connection string.  Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
# On Render, paste the "Internal Database URL" of your Render PostgreSQL here.
DATABASE_URL=postgresql://admissions:your_password_here@localhost:5432/admissions_db

# Frontend address(es) allowed to call this API. Comma-separated, no trailing slash.
# Local:      http://localhost:5173,http://127.0.0.1:5173
# Production: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# true = the "Load demo data" button works. Set to false once you use real student data.
ENABLE_DEMO_ENDPOINTS=true
