# --------------------------------------------------------------------------
# Admission Intelligence Backend Configuration
# Copy this file to .env and adjust variables as needed for your environment.
# NEVER commit sensitive production secrets to version control.
# --------------------------------------------------------------------------

# Database Connection URL (PostgreSQL default; fallback to SQLite for local tests)
# Format: postgresql+psycopg2://username:password@localhost:5432/admission_intelligence_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/admission_intelligence_db

# Security & JWT Configuration
# Generate a strong 32-byte secret using: openssl rand -hex 32
SECRET_KEY=change_this_to_a_very_secure_random_secret_key_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Environment Mode: 'development' | 'testing' | 'production'
ENVIRONMENT=development

# Allowed CORS Origins (Comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Application Metadata
PROJECT_NAME="Admission Enquiry Conversion Prediction API"
API_V1_STR=/api/v1
